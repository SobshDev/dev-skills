@@ -1,30 +1,45 @@
+import requests
+
 from orders.models import Order
 
+RATES_URL = "https://rates.example.com/latest"
+_rates_cache = {}
+
 
 class OrderService:
     def __init__(self, repo):
         self.repo = repo
 
-    def place(self, cid, items, country):
-        s = sum(i.price * i.qty for i in items)
-        fee = 5 if s < 50 else 0
-        tax = s * 0.2
-        o = Order(customer_id=cid, total=s + fee + tax)
-        self.repo.save(o)
-        return o
+    def place(self, customer_id, items, country, currency="EUR"):
+        subtotal = self._subtotal(items)
+        shipping = self._shipping(subtotal, country)
+        tax = subtotal * 0.2
+        total = subtotal + shipping + tax
+        if currency != "EUR":
+            total = total * self._rate(currency)
+        order = Order(customer_id=customer_id, total=total)
+        self.repo.save(order)
+        return order
+
+    def _subtotal(self, items):
+        return sum(item.price * item.qty for item in items)
+
+    def _shipping(self, subtotal, country):
+        if country in ("FR", "BE", "LU"):
+            return 0 if subtotal >= 40 else 4
+        return 7 if subtotal < 60 else 0
+
+    def _rate(self, currency):
+        if currency not in _rates_cache:
+            _rates_cache[currency] = requests.get(f"{RATES_URL}?base=EUR&symbol={currency}").json()["rate"]
+        return _rates_cache[currency]
+
+    # def _old_fee(self, s):
+    #     return 5 if s < 50 else 0
